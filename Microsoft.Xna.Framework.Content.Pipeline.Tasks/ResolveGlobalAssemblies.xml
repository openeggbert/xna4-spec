        <platform>Windows XP SP2</platform>
        <platform>Windows Vista</platform>
      </platforms>
    </constructor>
  </constructors>
  <properties>
    <property name="Assemblies" type="ITaskItem[]" access="get;set">
      <summary><![CDATA[Gets or sets the file names of the global assemblies to be modified. Any file names that are already pointing to the root directory of XNA Game Studio Express remain unchanged.]]></summary>
      <syntax><![CDATA[[OutputAttribute]
public ITaskItem[] Assemblies { get; set; }]]></syntax>
      <platforms>
        <platform>Windows XP SP2</platform>
        <platform>Windows Vista</platform>
      </platforms>
    </property>
    <property name="XnaFrameworkVersion" type="string" access="get;set">
      <summary><![CDATA[Gets or sets the XNA framework version, used to determine the xactbld.exe path.]]></summary>
