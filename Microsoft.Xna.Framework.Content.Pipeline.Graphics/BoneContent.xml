          name="BoneContent" kind="class"
          namespace="Microsoft.Xna.Framework.Content.Pipeline.Graphics"
          assembly="Microsoft.Xna.Framework.Content.Pipeline.Graphics"
          baseClass="NodeContent">
  <summary><![CDATA[Represents an animation skeleton.]]></summary>
  <syntax><![CDATA[public class BoneContent : NodeContent]]></syntax>
  <remarks><![CDATA[Animation skeletons are represented as a tree of BoneContent objects with the bind pose stored in their Transform properties. Animation data for the entire skeleton is stored in the Animations property of the root bone (represented by a BoneContent object); typically a sibling of the mesh being skinned.]]></remarks>
