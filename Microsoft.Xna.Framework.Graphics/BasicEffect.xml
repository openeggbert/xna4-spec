    <property name="LightingEnabled" type="bool" access="get;set">
      <summary><![CDATA[Enables lighting for this effect.]]></summary>
      <syntax><![CDATA[public bool LightingEnabled { get; set; }]]></syntax>
      <remarks><![CDATA[The lighting for BasicEffect is per-vertex and uses three directional lights: DirectionalLight0 , DirectionalLight1 , and DirectionalLight2 .]]></remarks>
      <platforms>
        <platform>Xbox 360</platform>
        <platform>Windows XP SP2</platform>
        <platform>Windows Vista</platform>
