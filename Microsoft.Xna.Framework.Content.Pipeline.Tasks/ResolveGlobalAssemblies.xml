          name="ResolveGlobalAssemblies" kind="class"
          namespace="Microsoft.Xna.Framework.Content.Pipeline.Tasks"
          assembly="Microsoft.Xna.Framework.Content.Pipeline.Tasks"
          baseClass="Task">
  <summary><![CDATA[An MSBuildTask that modifies the filenames of global content pipeline assemblies to point to a specific directory under the install path of XNA Game Studio Express.]]></summary>
  <syntax><![CDATA[public class ResolveGlobalAssemblies : Task]]></syntax>
  <platforms>
    <platform>Windows XP SP2</platform>
    <platform>Windows Vista</platform>
  </platforms>
