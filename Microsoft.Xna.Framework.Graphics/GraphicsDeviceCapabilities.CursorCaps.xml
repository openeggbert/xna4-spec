  <summary><![CDATA[Represents hardware support for cursors.]]></summary>
  <syntax><![CDATA[public struct GraphicsDeviceCapabilities.CursorCaps]]></syntax>
  <platforms>
    <platform>Xbox 360</platform>
    <platform>Windows XP SP2</platform>
