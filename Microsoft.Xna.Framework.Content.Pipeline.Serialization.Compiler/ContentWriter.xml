    <method name="WriteObject" returnType="void">
      <summary><![CDATA[Writes a single object to the output binary, using the specified type hint and writer worker.]]></summary>
      <overloads>
        <overload signature="WriteObject(T, ContentTypeWriter)">
          <summary><![CDATA[Writes a single object to the output binary, using the specified type hint and writer worker.]]></summary>
          <syntax><![CDATA[public void WriteObject<T> (
         T value,
         ContentTypeWriter typeWriter
)]]></syntax>
          <type-parameters>
            <type-parameter name="T"><![CDATA[The type of value .]]></type-parameter>
          </type-parameters>
          <parameters>
            <parameter name="value" type="T"><![CDATA[The value to write.]]></parameter>
            <parameter name="typeWriter" type="ContentTypeWriter"><![CDATA[The content type writer.]]></parameter>
          </parameters>
          <remarks><![CDATA[The type hint should be retrieved from the Initialize method of the ContentTypeWriter that is calling WriteObject , by calling GetTypeWriter and passing it the type of the field used to hold the value being serialized. If the hint type is a sealed value type (which cannot be null or hold a polymorphic object instance) this method skips writing the usual type identifier.]]></remarks>
          <platforms>
            <platform>Windows XP SP2</platform>
            <platform>Windows Vista</platform>
          </platforms>
        </overload>
        <overload signature="WriteObject(T)">
          <summary><![CDATA[Writes a single object preceded by a type identifier to the output binary.]]></summary>
          <syntax><![CDATA[public void WriteObject<T> (
         T value
)]]></syntax>
          <type-parameters>
            <type-parameter name="T"><![CDATA[The type of value .]]></type-parameter>
          </type-parameters>
          <parameters>
            <parameter name="value" type="T"><![CDATA[The value to write.]]></parameter>
          </parameters>
          <remarks><![CDATA[This method can be called recursively with a null value.]]></remarks>
          <platforms>
            <platform>Windows XP SP2</platform>
            <platform>Windows Vista</platform>
          </platforms>
        </overload>
      </overloads>
    </method>
    <method name="WriteRawObject" returnType="void">
      <summary><![CDATA[Writes a single object to the output binary using the specified writer worker.]]></summary>
      <overloads>
        <overload signature="WriteRawObject(T, ContentTypeWriter)">
          <summary><![CDATA[Writes a single object to the output binary using the specified writer worker.]]></summary>
          <syntax><![CDATA[public void WriteRawObject<T> (
         T value,
         ContentTypeWriter typeWriter
)]]></syntax>
          <type-parameters>
            <type-parameter name="T"><![CDATA[The type of value .]]></type-parameter>
          </type-parameters>
          <parameters>
            <parameter name="value" type="T"><![CDATA[The value to write.]]></parameter>
            <parameter name="typeWriter" type="ContentTypeWriter"><![CDATA[The writer worker. This should be looked up from the Initialize method of the ContentTypeWriter that is calling WriteRawObject , by calling GetTypeWriter .]]></parameter>
          </parameters>
          <remarks><![CDATA[WriteRawObject does not write any type identifier, so it cannot support null or polymorphic values, and the reader must specify an identical type while loading the compiled data.]]></remarks>
          <platforms>
            <platform>Windows XP SP2</platform>
            <platform>Windows Vista</platform>
          </platforms>
        </overload>
        <overload signature="WriteRawObject(T)">
          <summary><![CDATA[Writes a single object to the output binary as an instance of the specified type.]]></summary>
          <syntax><![CDATA[public void WriteRawObject<T> (
         T value
)]]></syntax>
          <type-parameters>
            <type-parameter name="T"><![CDATA[The type of value .]]></type-parameter>
          </type-parameters>
          <parameters>
            <parameter name="value" type="T"><![CDATA[The value to write.]]></parameter>
          </parameters>
          <remarks><![CDATA[If you specify a base class of the actual object value only data from this base type will be written. This method does not write any type identifier so it cannot support null or polymorphic values, and the reader must specify an identical type while loading the compiled data.]]></remarks>
          <platforms>
            <platform>Windows XP SP2</platform>
            <platform>Windows Vista</platform>
          </platforms>
        </overload>
      </overloads>
    </method>
