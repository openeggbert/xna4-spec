    <method name="Barycentric" returnType="float" isStatic="true">
      <summary><![CDATA[Returns the Cartesian coordinate for one axis of a point that is defined by a given triangle and two normalized barycentric (areal) coordinates.]]></summary>
      <overloads>
        <overload signature="Barycentric()">
          <summary><![CDATA[Returns the Cartesian coordinate for one axis of a point that is defined by a given triangle and two normalized barycentric (areal) coordinates.]]></summary>
          <syntax><![CDATA[public static float Barycentric (
         float value1,
         float value2,
         float value3,
         float amount1,
         float amount2
)]]></syntax>
          <parameters>
            <parameter name="value1" type="float"><![CDATA[The coordinate on one axis of vertex 1 of the defining triangle.]]></parameter>
            <parameter name="value2" type="float"><![CDATA[The coordinate on the same axis of vertex 2 of the defining triangle.]]></parameter>
            <parameter name="value3" type="float"><![CDATA[The coordinate on the same axis of vertex 3 of the defining triangle.]]></parameter>
            <parameter name="amount1" type="float"><![CDATA[The normalized barycentric (areal) coordinate b2 , equal to the weighting factor for vertex 2, the coordinate of which is specified in value2 .]]></parameter>
            <parameter name="amount2" type="float"><![CDATA[The normalized barycentric (areal) coordinate b3 , equal to the weighting factor for vertex 3, the coordinate of which is specified in value3 .]]></parameter>
          </parameters>
          <returns><![CDATA[Cartesian coordinate of the specified point with respect to the axis being used.]]></returns>
          <platforms>
            <platform>Xbox 360</platform>
            <platform>Windows XP SP2</platform>
            <platform>Windows Vista</platform>
          </platforms>
        </overload>
      </overloads>
    </method>
