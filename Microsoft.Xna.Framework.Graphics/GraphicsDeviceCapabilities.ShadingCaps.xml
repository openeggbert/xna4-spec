    <property name="SupportsAlphaGouraudBlend" type="bool" access="get">
      <summary><![CDATA[Gets a value indicating whether the device can support an alpha component for Gouraud-blended transparency.]]></summary>
      <syntax><![CDATA[public bool SupportsAlphaGouraudBlend { get; }]]></syntax>
      <remarks><![CDATA[In this mode, the alpha color component of a primitive is provided at vertices and interpolated across a face along with the other color components.]]></remarks>
      <platforms>
        <platform>Xbox 360</platform>
        <platform>Windows XP SP2</platform>
        <platform>Windows Vista</platform>
